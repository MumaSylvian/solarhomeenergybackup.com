{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "functions": {
    "api/order-request.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/product",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>[a-z0-9-]+)" }],
      "destination": "/products/:slug",
      "permanent": true
    },
    {
      "source": "/products/:base(.+)-costco-sale-:n(\\d+)",
      "destination": "/products/:base-:n",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/catalog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
